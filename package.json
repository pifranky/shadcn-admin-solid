{
  "name": "shadcn-admin-solid",
  "private": false,
  "version": "1.0.0",
  "type": "module",
  "description": "Admin dashboard UI built with SolidJS, Kobalte, Tailwind CSS and Vite. A SolidJS port of satnaing/shadcn-admin.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "dependencies": {
    "@corvu/otp-field": "^0.1.4",
    "@kobalte/core": "^0.13.14",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/solid-query": "^5.105.0",
    "@tanstack/solid-router": "^1.170.43",
    "@tanstack/solid-table": "^8.21.3",
    "axios": "^1.21.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-solid": "^1.65.0",
    "solid-js": "^1.9.18",
    "solid-sonner": "^0.3.3",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@tanstack/router-plugin": "^1.168.48",
    "@tanstack/solid-router-devtools": "^1.167.2",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^26.6.6",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-solid": "^2.11.15",
    "vitest": "^5.0.5"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pifranky/shadcn-admin-solid.git"
  },
  "keywords": [
    "solidjs",
    "kobalte",
    "shadcn",
    "tailwindcss",
    "admin-dashboard",
    "tanstack-router"
  ]
}
